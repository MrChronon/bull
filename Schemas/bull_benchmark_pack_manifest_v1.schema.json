{
  "title": "BULL Benchmark Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "status",
    "visibility",
    "engine",
    "license",
    "provenance",
    "taxonomy",
    "content",
    "gold",
    "documentation"
  ],
  "properties": {
    "schema": {"const": "bull-benchmark-pack-manifest"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "version": {"type": "string", "pattern": "^\\d+(?:\\.\\d+){2,3}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["experimental", "candidate", "stable", "deprecated", "retired"]
    },
    "visibility": {"enum": ["public", "private"]},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version"],
      "properties": {
        "minimum_version": {"type": "string", "pattern": "^\\d+(?:\\.\\d+){2,3}$"},
        "maximum_version": {"type": "string", "pattern": "^\\d+(?:\\.\\d+){2,3}$"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {"source": {"type": "string", "minLength": 1}}
    },
    "taxonomy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "case_count"],
      "properties": {
        "cases_file": {"type": "string", "minLength": 1},
        "generator": {"type": "object"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "case_count": {"type": "integer", "minimum": 1, "maximum": 1000}
      },
      "oneOf": [
        {"required": ["cases_file"], "not": {"required": ["generator"]}},
        {"required": ["generator"], "not": {"required": ["cases_file"]}}
      ]
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "documentation": {"type": "string", "minLength": 1}
  }
}
